NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

POSTGRES_USER=cardplay
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cardplay
POSTGRES_PORT=5434
DATABASE_URL=postgres://cardplay:change_me@localhost:5434/cardplay

# both secrets: at least 64 characters, different from each other; generate with: openssl rand -hex 64
JWT_SECRET=change_me_min_64_chars
JWT_REFRESH_SECRET=change_me_different_min_64_chars

# only for the Docker stack of compose.app.yml (npm run app:up)
# the address the browser opens; CLIENT_ORIGIN of the server is set to it
PUBLIC_ORIGIN=http://localhost:8080
APP_PORT=8080
# development runs without a reverse proxy; the compose stack sets TRUST_PROXY=1
TRUST_PROXY=0
